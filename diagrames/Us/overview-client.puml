@startuml us-overview-client
skinparam actorStyle awesome
left to right direction

title Panorama — client\n

actor Client
actor "Mapa / ubicació" as Mapa
actor "Passarel·la de pagament" as Pay


package "Exploració" {
  usecase "Veure plats/menús o cuiners actius" as C1
  usecase "Veure resultats ordenats per distància" as C2
  usecase "Veure tots els plats d'un cuiner" as C3
  usecase "Reservar comanda per quan el cuiner estigui disponible" as C4
}
package "Comandes i historial" {
  usecase "Fer una comanda\n(màx. 3 actives)" as C5
