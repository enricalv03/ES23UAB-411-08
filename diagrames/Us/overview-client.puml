  usecase "Repetir una comanda anterior" as C7
  usecase "Veure les meves valoracions" as C8
}
package "Recollida i seguiment" {
  usecase "Triar com recollir la comanda" as C9
  usecase "Veure cost d'enviament" as C10
  usecase "Seguir l'enviament al mapa" as C11
}
package "Pagament" {
  usecase "Pagar una comanda" as C12
  usecase "Guardar mètode de pagament al perfil" as C13
}
package "Valoracions i fidelització" {
  usecase "Valorar una comanda rebuda" as C14
