  usecase "Usar punts i descomptes\n(si està subscrit)" as C16
}
package "Plats personalitzats" {
  usecase "Proposar un plat personalitzat" as C17
  usecase "Eliminar una proposta\n(encara no acceptada)" as C18
  usecase "Xat amb el cuiner\n(proposta acceptada)" as C19
}

