@startuml
title Diagrama de seqüència - Fer una comanda (màxim 3 actives)  

actor Client
actor Cuiner

boundary "PantallaComanda" as PantallaClient
boundary "PantallaCuiner" as PantallaCuiner
control "GestorComandes" as Gestor
entity "Client" as ClientEntitat
entity "Comanda" as ComandaEntitat

Client -> PantallaClient: seleccionarPlats()
activate PantallaClient

PantallaClient -> Gestor: enviarSeleccioPlats()
activate Gestor

Gestor -> ClientEntitat: verificarLimitComandesActives()
activate ClientEntitat
ClientEntitat --> Gestor: numComandesActives
deactivate ClientEntitat

alt numComandesActives >= 3
    Gestor --> PantallaClient: error()
    PantallaClient --> Client: mostraError()
else numComandesActives < 3
    Gestor -> Gestor: calcularCostEnviament()
    Gestor --> PantallaClient: mostrarResum()
    PantallaClient --> Client: mostraResumComanda()
    
    Client -> PantallaClient: confirmarComanda()
    PantallaClient -> Gestor: confirmacioComanda()
    
    Gestor -> ComandaEntitat: crearComanda()
    activate ComandaEntitat
    ComandaEntitat --> Gestor: idComanda
    deactivate ComandaEntitat
    
    Gestor -> PantallaCuiner: notificarNovaComanda()
    activate PantallaCuiner
    PantallaCuiner --> Cuiner: mostraNotificacio()
    deactivate PantallaCuiner
    
    Gestor --> PantallaClient: comandaCreada()
    PantallaClient --> Client: mostraConfirmacio()
end

deactivate Gestor
deactivate PantallaClient
@enduml
