@startuml
title Diagrama de seqüència - Pagar una comanda   

actor Client
actor "Passarel·la pagament" as Passarella

boundary "PantallaPagament" as Pantalla
control "GestorPagaments" as Gestor
entity "Comanda" as ComandaEntitat

Client -> Pantalla: iniciarPagament()
activate Pantalla

Pantalla -> Gestor: procesarPagament()
activate Gestor

Gestor -> ComandaEntitat: obtenirDetalls()
activate ComandaEntitat
ComandaEntitat --> Gestor: import, estat
deactivate ComandaEntitat

Gestor --> Pantalla: mostrarOpcionsPagament()
Pantalla --> Client: mostraOpcions()

Client -> Pantalla: seleccionarMetode()
Pantalla -> Gestor: enviaMetodePagament()

Gestor -> Passarella: processarPagament()
activate Passarella

alt pagament exitós
    Passarella --> Gestor: confirmacioOK()
    deactivate Passarella
    Gestor -> ComandaEntitat: actualitzarEstat()
    activate ComandaEntitat
    ComandaEntitat --> Gestor: estatActualitzat
    deactivate ComandaEntitat
    Gestor --> Pantalla: pagamentConfirmat()
    Pantalla --> Client: mostraConfirmacio()
else pagament fallit
    Passarella --> Gestor: errorPagament()
    deactivate Passarella
    Gestor --> Pantalla: mostrarError()
    Pantalla --> Client: mostraError()
    note right of Gestor: El client pot reintentar\n(flux alternatiu)
    loop reintent
        Client -> Pantalla: reintentarPagament()
        Pantalla -> Gestor: reintentar()
        Gestor -> Passarella: processarPagament()
        ' es podria afegir més detall, però es simplifica
    end
end

deactivate Gestor
deactivate Pantalla
@enduml
