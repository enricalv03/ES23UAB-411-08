@startuml
skinparam defaultFontName Helvetica

title Diagrama de sequencia - Proposar un plat personalitzat

actor Client

boundary "PantallaPropostaPlat" as Pantalla
control "GestorPropostes" as Gestor
entity "Plat" as PlatEntitat
entity "PropostaPlat" as PropostaEntitat

Client -> Pantalla: iniciarProposta()
activate Pantalla

Pantalla -> Gestor: prepararProposta()
activate Gestor
Gestor --> Pantalla: mostrarOpcions()
Pantalla --> Client: mostraOpcions()

Client -> Pantalla: seleccionarTipusProposta()

alt plat completament nou
    Client -> Pantalla: introduirDadesPlat()
    Pantalla -> Gestor: enviarPropostaNova(dades)
else modificar recepta existent
    Client -> Pantalla: seleccionarPlat()
    Pantalla -> Gestor: obtenirIngredientsOpcionals()

    Gestor -> PlatEntitat: consultarIngredientsOpcionals()
    activate PlatEntitat
    PlatEntitat --> Gestor: ingredientsOpcionals
    deactivate PlatEntitat

    Gestor --> Pantalla: mostrarIngredientsOpcionals()
    Pantalla --> Client: mostraIngredientsOpcionals()

    Client -> Pantalla: seleccionarIngredientsAEliminar()
    Pantalla -> Gestor: enviarModificacio(ingredients)
end

Gestor -> PropostaEntitat: registrarProposta()
activate PropostaEntitat
PropostaEntitat --> Gestor: propostaRegistrada
deactivate PropostaEntitat

Gestor --> Pantalla: confirmarProposta()
Pantalla --> Client: mostraConfirmacio()

deactivate Gestor
deactivate Pantalla

@enduml
