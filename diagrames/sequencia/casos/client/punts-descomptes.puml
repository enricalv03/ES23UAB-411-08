
@startuml
skinparam defaultFontName Helvetica

title Diagrama de seqüència - Posar punts i descomptes

actor Client
boundary PantallaPagament
control GestorPunts
entity "Subscripció" as Subscripcio
entity Comanda

Client -> PantallaPagament: iniciarProcesCompra()
PantallaPagament -> GestorPunts: consultarPunts()
GestorPunts -> Subscripcio: obtenirPuntsDisponibles()
Subscripcio --> GestorPunts: puntsDisponibles
GestorPunts --> PantallaPagament: mostrarPunts(puntsDisponibles)

Client -> PantallaPagament: aplicarDescompte()
PantallaPagament -> GestorPunts: comprovarPunts()

alt punts suficients
    GestorPunts -> Comanda: recalcularImport()
    Comanda --> GestorPunts: importFinal
    GestorPunts --> PantallaPagament: retornarImportFinal(importFinal)
    PantallaPagament --> Client: mostrarImportFinal()
else punts insuficients
    GestorPunts --> PantallaPagament: informarPuntsInsuficients()
    PantallaPagament --> Client: mostrarMissatge()
end

@enduml

