@startuml
title Diagrama de seqüència - Repetir una comanda anterior

actor Client

boundary "PantallaHistorial" as Pantalla
control "GestorComandes" as Gestor
entity "Comanda" as ComandaDB
entity "Plat" as PlatDB

Client -> Pantalla: seleccionarComandaHistorial()
activate Pantalla

Pantalla -> Gestor: sollicitarRepeticio()
activate Gestor

Gestor -> ComandaDB: obtenirPlatsComanda()
activate ComandaDB
ComandaDB --> Gestor: llistatPlatsOriginal
deactivate ComandaDB

Gestor -> PlatDB: verificarDisponibilitatPlats()
activate PlatDB
PlatDB --> Gestor: platsDisponibles, platsNoDisponibles
deactivate PlatDB

alt totsElsPlatsDisponibles
    Gestor -> ComandaDB: crearNovaComanda()
    activate ComandaDB
    ComandaDB --> Gestor: novaComandaCreada
    deactivate ComandaDB
    
    Gestor --> Pantalla: continuarAmbFerComanda()
    Pantalla --> Client: redirigirAConfirmacio()
    
else hiHaPlatsNoDisponibles
    Gestor --> Pantalla: informarPlatsNoDisponibles()
    Pantalla --> Client: mostrarErrorPlatsNoDisponibles()
end

deactivate Gestor
deactivate Pantalla
@enduml
