@startuml
title Diagrama de seqüència - Rebre diners al compte 

actor Client
actor "Passarel·la pagament" as Passarella
actor Cuiner

boundary "PantallaPagament" as PantallaClient
boundary "PantallaCuiner" as PantallaCuiner
control "GestorPagaments" as Gestor
entity "Comanda" as ComandaDB
entity "Cuiner" as CuinerDB

Client -> PantallaClient: pagarComanda()
activate PantallaClient

PantallaClient -> Gestor: processarPagament()
activate Gestor

Gestor -> Passarella: processarPagament()
activate Passarella

alt pagament exitós
    Passarella --> Gestor: confirmacioOK()
    deactivate Passarella
    
    Gestor -> ComandaDB: actualitzarEstat()
    activate ComandaDB
    ComandaDB --> Gestor: ok
    deactivate ComandaDB
    
    Gestor -> CuinerDB: obtenirCompteBancari()
    activate CuinerDB
    CuinerDB --> Gestor: dadesBancaries
    deactivate CuinerDB
    
    Gestor -> Passarella: ingressarImport()
    activate Passarella
    Passarella --> Gestor: ingressConfirmat
    deactivate Passarella
    
    opt comanda amb repartidor
        Gestor -> Passarella: ingressarImport(repartidor)
        activate Passarella
        Passarella --> Gestor: ingressConfirmat
        deactivate Passarella
    end
    
    Gestor -> PantallaCuiner: notificarIngres()
    activate PantallaCuiner
    PantallaCuiner --> Cuiner: mostraNotificacio()
    deactivate PantallaCuiner
    
    Gestor --> PantallaClient: pagamentConfirmat()
    PantallaClient --> Client: mostraConfirmacio()
    
else pagament fallit
    Passarella --> Gestor: error()
    deactivate Passarella
    Gestor -> PantallaCuiner: notificarIntentFallit()
    activate PantallaCuiner
    PantallaCuiner --> Cuiner: mostraError()
    deactivate PantallaCuiner
    Gestor --> PantallaClient: errorPagament()
    PantallaClient --> Client: mostraError()
end

deactivate Gestor
deactivate PantallaClient
@enduml
