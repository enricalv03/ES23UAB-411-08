@startuml
title Diagrama de seqüència - Realitzar lliurament de comanda  

actor Repartidor
actor Client

boundary "PantallaLliurament" as Pantalla
control "GestorComandes" as Gestor
entity "Comanda" as ComandaDB

Repartidor -> Pantalla: seleccionarComanda()
activate Pantalla

Pantalla -> Gestor: enviaSeleccioComanda()
activate Gestor

Gestor -> ComandaDB: obtenirEstat()
activate ComandaDB
ComandaDB --> Gestor: estat = "recollida"
deactivate ComandaDB

Repartidor -> Pantalla: confirmarLliurament()
Pantalla -> Gestor: enviaConfirmacioLliurament()

Gestor -> ComandaDB: actualitzarEstat()
activate ComandaDB
ComandaDB --> Gestor: estatActualitzat
deactivate ComandaDB

Gestor -> Client: notificarComandaRebuda()
Gestor --> Pantalla: confirmacioLliurament()
Pantalla --> Repartidor: mostraConfirmacio()

deactivate Gestor
deactivate Pantalla
@enduml
