@startuml
title Diagrama de seqüència - Registrar-se

actor "Usuari no registrat" as Usuari

boundary "PantallaRegistre" as Pantalla
control "GestorUsuaris" as Gestor
entity "Usuari" as UsuariDB

Usuari -> Pantalla: omplirFormulari()
activate Pantalla

Pantalla -> Gestor: enviaDadesRegistre()
activate Gestor

Gestor -> UsuariDB: verificarExistencia()
activate UsuariDB
UsuariDB --> Gestor: existeix
deactivate UsuariDB

alt existeix == false
    Gestor -> Gestor: xifrarContrasenya()
    Gestor -> UsuariDB: crearCompte()
    activate UsuariDB
    UsuariDB --> Gestor: compteCreat
    deactivate UsuariDB
    Gestor --> Pantalla: confirmacioRegistre()
    Pantalla --> Usuari: mostraConfirmacio()
else existeix == true
    Gestor --> Pantalla: error()
    Pantalla --> Usuari: mostraError()
end

deactivate Gestor
deactivate Pantalla
@enduml
